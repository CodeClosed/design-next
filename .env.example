# ==============================================================================
# Corporate Website Starter Template — Environment Variables
# Copy this file to `.env.local` and supply actual credentials before production.
# Never commit real secrets or API keys to version control.
# ==============================================================================

# Canonical public site URL used for SEO metadata, canonical links, and sitemap.xml
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enquiry Email Provider Abstraction
# Supported values: "mock" | "resend" | "smtp"
# When unset or "mock", enquiries run in transparent development_preview mode.
EMAIL_PROVIDER=mock

# Sender and recipient addresses for corporate enquiries & RFQs
EMAIL_FROM=no-reply@example-sugar-engineering.invalid
EMAIL_TO_SALES=sales@example-sugar-engineering.invalid

# Option A: Resend API Configuration (set EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# Option B: SMTP Configuration (set EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional Rate Limiting for /api/enquiry (max requests per 10-minute window per IP)
RATE_LIMIT_MAX_REQUESTS=15

# Optional Analytics Measurement ID (leave blank to disable analytics)
NEXT_PUBLIC_ANALYTICS_ID=
